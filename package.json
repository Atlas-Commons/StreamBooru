{
  "name": "streambooru",
  "version": "1.2.0-beta.1",
  "description": "StreamBooru – Electron app to browse multiple booru sites with New and Popular feeds, merged across sources.",
  "main": "electron/main.js",
  "desktopName": "streambooru.desktop",
  "author": {
    "name": "Atlas-Commons",
    "email": "mrhowe95@gmail.com"
  },
  "homepage": "https://github.com/Atlas-Commons/StreamBooru",
  "repository": {
    "type": "git",
    "url": "https://github.com/Atlas-Commons/StreamBooru.git"
  },
  "license": "GPLv3",
  "scripts": {
    "start": "electron .",
    "dev": "SB_DEV=1 electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "android:add": "npx cap add android",
    "android:sync": "node scripts/sync-android-version.mjs && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew bundleRelease",
    "webapp:build": "node scripts/build-webapp.mjs",
    "webapp:check": "node scripts/build-webapp.mjs --check",
    "test:tags": "node scripts/test-query-tags.js",
    "test:media": "node scripts/test-media.js",
    "test:server": "node scripts/test-server-local.js",
    "test:server:deployed": "node scripts/test-server-smoke.js",
    "test:package": "node scripts/test-packaged-app.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1"
  }
}
