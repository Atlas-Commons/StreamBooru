# Keep Coolify/Nixpacks build context small (server + renderer are required)
node_modules
android
dist
release-*
.git
.github
flatpak
aur
aur-out
out-apk
out-aab
server/webapp
electron
build
docs
# contents, not the directory itself, so the exception below is always evaluated
scripts/*
# the Nixpacks build phase runs this one to generate server/webapp from renderer
!scripts/build-webapp.mjs
*.md
!server/README.md
