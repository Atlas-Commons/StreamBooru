PORT=3000
HOST=0.0.0.0
# Public URL (required behind Coolify/Cloudflare reverse proxy)
BASE_URL=https://streambooru.example.com

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# REQUIRED: a long random value (>= 16 chars). The server refuses to start with a
# placeholder/weak secret unless ALLOW_INSECURE_JWT_SECRET=1 (local dev only).
JWT_SECRET=change_me_to_a_long_random_string

DATABASE_URL=postgres://user:pass@host:5432/streambooru
PGSSL=false
# Set to false only if your managed Postgres uses a self-signed cert without a CA bundle.
PGSSL_REJECT_UNAUTHORIZED=true

# AES-256-GCM key derivation (do not lose — existing encrypted site creds become unreadable if changed)
ENC_SECRET=change_me_to_a_long_random_string_for_aes

# Optional webhook signing secret
WEBHOOK_SECRET=
